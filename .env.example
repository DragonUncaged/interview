# Copy to .env.local and fill in. Never commit real values.

# Supabase: Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Server only. Bypasses RLS: used for run results and hidden test cases.
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

# Optional: Postgres connection string, only for applying migrations with psql/CLI.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Code execution. Defaults to the public Wandbox API.
# PISTON_URL=http://your-piston-host:2000/api/v2   # use a self-hosted Piston instead
# WANDBOX_URL=https://wandbox.org/api

# Optional: two confirmed accounts for scripts/e2e.mjs and scripts/e2e2.mjs.
# TEST_INTERVIEWER_EMAIL=
# TEST_INTERVIEWER_PASSWORD=
# TEST_SECOND_EMAIL=
# TEST_SECOND_PASSWORD=

# Optional: shared rate-limit counter for serverless / multi-instance deploys.
# Without it, each instance counts on its own (effective limit = max × instances).
# UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<rest-token>
